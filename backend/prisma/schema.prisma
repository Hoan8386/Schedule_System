// =========================================================
// DATABASE: QUAN LY DANG KY LICH LAM VIEC
// Prisma Schema - PostgreSQL
// =========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =========================================================
// 1. VAI TRO (Role)
// =========================================================

model VaiTro {
  id            BigInt   @id @default(autoincrement())
  maVaiTro      String   @unique @map("ma_vai_tro") @db.VarChar(50)
  tenVaiTro     String   @map("ten_vai_tro") @db.VarChar(100)
  moTa          String?  @map("mo_ta") @db.Text
  dangHoatDong  Boolean  @default(true) @map("dang_hoat_dong")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  nguoiDungs    NguoiDung[]
  vaiTroQuyens  VaiTroQuyen[]

  @@index([dangHoatDong], name: "idx_vai_tro_dang_hoat_dong")
  @@map("vai_tro")
}

// =========================================================
// 2. QUYEN (Permission)
// =========================================================

model Quyen {
  id            BigInt   @id @default(autoincrement())
  maQuyen       String   @unique @map("ma_quyen") @db.VarChar(100)
  tenQuyen      String   @map("ten_quyen") @db.VarChar(150)
  apiPath       String   @map("api_path") @db.VarChar(255)
  httpMethod    String   @map("http_method") @db.VarChar(10)
  moTa          String?  @map("mo_ta") @db.Text
  dangHoatDong  Boolean  @default(true) @map("dang_hoat_dong")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  vaiTroQuyens  VaiTroQuyen[]

  @@unique([apiPath, httpMethod], name: "uk_quyen_api")
  @@index([apiPath], name: "idx_quyen_api_path")
  @@index([httpMethod], name: "idx_quyen_http_method")
  @@index([dangHoatDong], name: "idx_quyen_dang_hoat_dong")
  @@map("quyen")
}

// =========================================================
// 3. NGUOI DUNG (User)
// =========================================================

model NguoiDung {
  id               BigInt    @id @default(autoincrement())
  maNguoiDung      String    @unique @map("ma_nguoi_dung") @db.VarChar(50)
  hoTen            String    @map("ho_ten") @db.VarChar(255)
  email            String    @unique @db.VarChar(255)
  soDienThoai      String?   @unique @map("so_dien_thoai") @db.VarChar(20)
  matKhau          String    @map("mat_khau") @db.VarChar(255)
  anhDaiDien       String?   @map("anh_dai_dien") @db.VarChar(500)
  vaiTroId         BigInt    @map("vai_tro_id")
  trangThai        String    @default("HOAT_DONG") @map("trang_thai") @db.VarChar(30)
  lanDangNhapCuoi  DateTime? @map("lan_dang_nhap_cuoi") @db.Timestamptz()
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  vaiTro               VaiTro                @relation(fields: [vaiTroId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  dangKyCas            DangKyCa[]            @relation("NguoiDangKy")
  dangKyCaDuyet        DangKyCa[]            @relation("NguoiDuyet")
  dangKyCaTuChoi       DangKyCa[]            @relation("NguoiTuChoi")
  yeuCauThayDois       YeuCauThayDoiLich[]   @relation("NguoiYeuCau")
  yeuCauXuLy           YeuCauThayDoiLich[]   @relation("NguoiXuLy")
  lichSuNguoiDung      LichSuThayDoiLich[]   @relation("LichSuNguoiDung")
  lichSuNguoiThayDoi   LichSuThayDoiLich[]   @relation("LichSuNguoiThayDoi")
  kyDangKyTao          KyDangKyLich[]        @relation("NguoiTaoKy")
  noiQuyTao            NoiQuyLich[]          @relation("NguoiTaoNoiQuy")
  thongBaos            ThongBao[]
  nhatKyHeThongs       NhatKyHeThong[]

  @@index([vaiTroId], name: "idx_nguoi_dung_vai_tro")
  @@index([trangThai], name: "idx_nguoi_dung_trang_thai")
  @@map("nguoi_dung")
}

// =========================================================
// 4. VAI TRO - QUYEN (Role-Permission)
// =========================================================

model VaiTroQuyen {
  id        BigInt   @id @default(autoincrement())
  vaiTroId  BigInt   @map("vai_tro_id")
  quyenId   BigInt   @map("quyen_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  vaiTro    VaiTro   @relation(fields: [vaiTroId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  quyen     Quyen    @relation(fields: [quyenId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([vaiTroId, quyenId], name: "uk_vai_tro_quyen")
  @@index([vaiTroId], name: "idx_vai_tro_quyen_vai_tro")
  @@index([quyenId], name: "idx_vai_tro_quyen_quyen")
  @@map("vai_tro_quyen")
}

// =========================================================
// 5. CA LAM VIEC (Shift)
// =========================================================

model CaLamViec {
  id              BigInt   @id @default(autoincrement())
  maCa            String   @unique @map("ma_ca") @db.VarChar(50)
  tenCa           String   @map("ten_ca") @db.VarChar(100)
  gioBatDau       DateTime @map("gio_bat_dau") @db.Time()
  gioKetThuc      DateTime @map("gio_ket_thuc") @db.Time()
  soNguoiToiDa    Int      @map("so_nguoi_toi_da")
  thuTuHienThi    Int      @default(0) @map("thu_tu_hien_thi")
  trangThai       String   @default("HOAT_DONG") @map("trang_thai") @db.VarChar(30)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  caTheoNgays     CaLamViecTheoNgay[]

  @@index([trangThai], name: "idx_ca_lam_viec_trang_thai")
  @@map("ca_lam_viec")
}

// =========================================================
// 6. KY DANG KY LICH (Registration Period)
// =========================================================

model KyDangKyLich {
  id                   BigInt    @id @default(autoincrement())
  tenKy                String    @map("ten_ky") @db.VarChar(100)
  nam                  Int
  thang                Int
  thoiGianMoDangKy     DateTime? @map("thoi_gian_mo_dang_ky") @db.Timestamptz()
  thoiGianDongDangKy   DateTime? @map("thoi_gian_dong_dang_ky") @db.Timestamptz()
  thoiGianChotLich     DateTime? @map("thoi_gian_chot_lich") @db.Timestamptz()
  trangThai            String    @default("NHAP") @map("trang_thai") @db.VarChar(30)
  nguoiTaoId           BigInt?   @map("nguoi_tao_id")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  nguoiTao             NguoiDung?          @relation("NguoiTaoKy", fields: [nguoiTaoId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  caTheoNgays          CaLamViecTheoNgay[]
  quyTacLichs          QuyTacLich[]
  noiQuyLichs          NoiQuyLich[]

  @@unique([nam, thang], name: "uk_ky_dang_ky_lich_nam_thang")
  @@index([trangThai], name: "idx_ky_dang_ky_lich_trang_thai")
  @@map("ky_dang_ky_lich")
}

// =========================================================
// 7. CA LAM VIEC THEO NGAY (Daily Shift)
// =========================================================

model CaLamViecTheoNgay {
  id              BigInt   @id @default(autoincrement())
  kyDangKyLichId  BigInt   @map("ky_dang_ky_lich_id")
  caLamViecId     BigInt   @map("ca_lam_viec_id")
  ngayLamViec     DateTime @map("ngay_lam_viec") @db.Date
  gioBatDau       DateTime @map("gio_bat_dau") @db.Time()
  gioKetThuc      DateTime @map("gio_ket_thuc") @db.Time()
  soNguoiToiDa    Int      @map("so_nguoi_toi_da")
  trangThai       String   @default("MO") @map("trang_thai") @db.VarChar(30)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  kyDangKyLich         KyDangKyLich          @relation(fields: [kyDangKyLichId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  caLamViec            CaLamViec             @relation(fields: [caLamViecId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  dangKyCas            DangKyCa[]
  yeuCauCaCu           YeuCauThayDoiLich[]   @relation("CaCu")
  yeuCauCaMoi          YeuCauThayDoiLich[]   @relation("CaMoi")
  lichSuCaCu           LichSuThayDoiLich[]   @relation("LichSuCaCu")
  lichSuCaMoi          LichSuThayDoiLich[]   @relation("LichSuCaMoi")

  @@unique([caLamViecId, ngayLamViec], name: "uk_ca_theo_ngay")
  @@index([kyDangKyLichId], name: "idx_ca_theo_ngay_ky")
  @@index([ngayLamViec], name: "idx_ca_theo_ngay_ngay")
  @@index([trangThai], name: "idx_ca_theo_ngay_trang_thai")
  @@map("ca_lam_viec_theo_ngay")
}

// =========================================================
// 8. DANG KY CA (Shift Registration)
// =========================================================

model DangKyCa {
  id                   BigInt    @id @default(autoincrement())
  nguoiDungId          BigInt    @map("nguoi_dung_id")
  caLamViecTheoNgayId  BigInt    @map("ca_lam_viec_theo_ngay_id")
  trangThai            String    @default("CHO_DUYET") @map("trang_thai") @db.VarChar(30)
  thoiGianDangKy       DateTime  @default(now()) @map("thoi_gian_dang_ky") @db.Timestamptz()
  thoiGianDuyet        DateTime? @map("thoi_gian_duyet") @db.Timestamptz()
  nguoiDuyetId         BigInt?   @map("nguoi_duyet_id")
  thoiGianTuChoi       DateTime? @map("thoi_gian_tu_choi") @db.Timestamptz()
  nguoiTuChoiId        BigInt?   @map("nguoi_tu_choi_id")
  lyDoTuChoi           String?   @map("ly_do_tu_choi") @db.Text
  ghiChu               String?   @map("ghi_chu") @db.Text
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  nguoiDung            NguoiDung          @relation("NguoiDangKy", fields: [nguoiDungId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  caLamViecTheoNgay    CaLamViecTheoNgay  @relation(fields: [caLamViecTheoNgayId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  nguoiDuyet           NguoiDung?         @relation("NguoiDuyet", fields: [nguoiDuyetId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  nguoiTuChoi          NguoiDung?         @relation("NguoiTuChoi", fields: [nguoiTuChoiId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  yeuCauThayDois       YeuCauThayDoiLich[]
  lichSuThayDois       LichSuThayDoiLich[]

  @@unique([nguoiDungId, caLamViecTheoNgayId], name: "uk_dang_ky_ca")
  @@index([nguoiDungId], name: "idx_dang_ky_ca_nguoi_dung")
  @@index([caLamViecTheoNgayId], name: "idx_dang_ky_ca_ca")
  @@index([trangThai], name: "idx_dang_ky_ca_trang_thai")
  @@map("dang_ky_ca")
}

// =========================================================
// 9. YEU CAU THAY DOI LICH (Schedule Change Request)
// =========================================================

model YeuCauThayDoiLich {
  id              BigInt    @id @default(autoincrement())
  nguoiDungId     BigInt    @map("nguoi_dung_id")
  loaiYeuCau      String    @map("loai_yeu_cau") @db.VarChar(30)
  dangKyCaId      BigInt?   @map("dang_ky_ca_id")
  caCuId          BigInt?   @map("ca_cu_id")
  caMoiId         BigInt?   @map("ca_moi_id")
  lyDo            String    @map("ly_do") @db.Text
  trangThai       String    @default("CHO_DUYET") @map("trang_thai") @db.VarChar(30)
  thoiGianYeuCau  DateTime  @default(now()) @map("thoi_gian_yeu_cau") @db.Timestamptz()
  thoiGianXuLy    DateTime? @map("thoi_gian_xu_ly") @db.Timestamptz()
  nguoiXuLyId     BigInt?   @map("nguoi_xu_ly_id")
  ghiChuXuLy      String?   @map("ghi_chu_xu_ly") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  nguoiDung       NguoiDung          @relation("NguoiYeuCau", fields: [nguoiDungId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  dangKyCa        DangKyCa?          @relation(fields: [dangKyCaId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  caCu            CaLamViecTheoNgay? @relation("CaCu", fields: [caCuId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  caMoi           CaLamViecTheoNgay? @relation("CaMoi", fields: [caMoiId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  nguoiXuLy       NguoiDung?         @relation("NguoiXuLy", fields: [nguoiXuLyId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([nguoiDungId], name: "idx_yeu_cau_nguoi_dung")
  @@index([trangThai], name: "idx_yeu_cau_trang_thai")
  @@map("yeu_cau_thay_doi_lich")
}

// =========================================================
// 10. LICH SU THAY DOI LICH (Schedule Change History)
// =========================================================

model LichSuThayDoiLich {
  id              BigInt   @id @default(autoincrement())
  nguoiDungId     BigInt   @map("nguoi_dung_id")
  dangKyCaId      BigInt?  @map("dang_ky_ca_id")
  hanhDong        String   @map("hanh_dong") @db.VarChar(50)
  caCuId          BigInt?  @map("ca_cu_id")
  caMoiId         BigInt?  @map("ca_moi_id")
  lyDo            String?  @map("ly_do") @db.Text
  nguoiThayDoiId  BigInt   @map("nguoi_thay_doi_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  nguoiDung       NguoiDung          @relation("LichSuNguoiDung", fields: [nguoiDungId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  dangKyCa        DangKyCa?          @relation(fields: [dangKyCaId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  caCu            CaLamViecTheoNgay? @relation("LichSuCaCu", fields: [caCuId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  caMoi           CaLamViecTheoNgay? @relation("LichSuCaMoi", fields: [caMoiId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  nguoiThayDoi    NguoiDung          @relation("LichSuNguoiThayDoi", fields: [nguoiThayDoiId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([nguoiDungId], name: "idx_lich_su_nguoi_dung")
  @@index([dangKyCaId], name: "idx_lich_su_dang_ky")
  @@index([createdAt], name: "idx_lich_su_created_at")
  @@map("lich_su_thay_doi_lich")
}

// =========================================================
// 11. NGAY LE (Holiday)
// =========================================================

model NgayLe {
  id            BigInt   @id @default(autoincrement())
  tenNgayLe     String   @map("ten_ngay_le") @db.VarChar(255)
  ngay          DateTime @unique @db.Date
  moTa          String?  @map("mo_ta") @db.Text
  dangHoatDong  Boolean  @default(true) @map("dang_hoat_dong")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([ngay], name: "idx_ngay_le_ngay")
  @@map("ngay_le")
}

// =========================================================
// 12. QUY TAC LICH (Schedule Rule)
// =========================================================

model QuyTacLich {
  id              BigInt    @id @default(autoincrement())
  kyDangKyLichId  BigInt?   @map("ky_dang_ky_lich_id")
  maQuyTac        String    @map("ma_quy_tac") @db.VarChar(100)
  giaTri          String    @map("gia_tri") @db.VarChar(500)
  moTa            String?   @map("mo_ta") @db.Text
  dangHoatDong    Boolean   @default(true) @map("dang_hoat_dong")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  kyDangKyLich    KyDangKyLich? @relation(fields: [kyDangKyLichId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([kyDangKyLichId, maQuyTac], name: "uk_quy_tac_ky")
  @@map("quy_tac_lich")
}

// =========================================================
// 13. NOI QUY LICH (Schedule Regulation)
// =========================================================

model NoiQuyLich {
  id              BigInt    @id @default(autoincrement())
  kyDangKyLichId  BigInt?   @map("ky_dang_ky_lich_id")
  tieuDe          String    @map("tieu_de") @db.VarChar(255)
  noiDung         String    @map("noi_dung") @db.Text
  trangThai       String    @default("HOAT_DONG") @map("trang_thai") @db.VarChar(30)
  nguoiTaoId      BigInt?   @map("nguoi_tao_id")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  kyDangKyLich    KyDangKyLich? @relation(fields: [kyDangKyLichId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  nguoiTao        NguoiDung?    @relation("NguoiTaoNoiQuy", fields: [nguoiTaoId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@map("noi_quy_lich")
}

// =========================================================
// 14. THONG BAO (Notification)
// =========================================================

model ThongBao {
  id                      BigInt    @id @default(autoincrement())
  nguoiDungId             BigInt    @map("nguoi_dung_id")
  loaiThongBao            String    @map("loai_thong_bao") @db.VarChar(50)
  tieuDe                  String    @map("tieu_de") @db.VarChar(255)
  noiDung                 String    @map("noi_dung") @db.Text
  loaiDoiTuongThamChieu   String?   @map("loai_doi_tuong_tham_chieu") @db.VarChar(50)
  doiTuongThamChieuId     BigInt?   @map("doi_tuong_tham_chieu_id")
  daDoc                   Boolean   @default(false) @map("da_doc")
  thoiGianDoc             DateTime? @map("thoi_gian_doc") @db.Timestamptz()
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  nguoiDung               NguoiDung @relation(fields: [nguoiDungId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([nguoiDungId], name: "idx_thong_bao_nguoi_dung")
  @@index([daDoc], name: "idx_thong_bao_da_doc")
  @@index([createdAt], name: "idx_thong_bao_created_at")
  @@map("thong_bao")
}

// =========================================================
// 15. CAU HINH THONG BAO (Notification Config)
// =========================================================

model CauHinhThongBao {
  id          BigInt   @id @default(autoincrement())
  kenh        String   @db.VarChar(20)
  loaiSuKien  String   @map("loai_su_kien") @db.VarChar(50)
  bat         Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([kenh, loaiSuKien], name: "uk_cau_hinh_thong_bao")
  @@map("cau_hinh_thong_bao")
}

// =========================================================
// 16. MAU THONG BAO (Notification Template)
// =========================================================

model MauThongBao {
  id            BigInt   @id @default(autoincrement())
  kenh          String   @db.VarChar(20)
  loaiSuKien    String   @map("loai_su_kien") @db.VarChar(50)
  tieuDe        String?  @map("tieu_de") @db.VarChar(255)
  noiDung       String   @map("noi_dung") @db.Text
  dangHoatDong  Boolean  @default(true) @map("dang_hoat_dong")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([kenh, loaiSuKien], name: "uk_mau_thong_bao")
  @@map("mau_thong_bao")
}

// =========================================================
// 17. NHAT KY HE THONG (System Audit Log)
// =========================================================

model NhatKyHeThong {
  id            BigInt   @id @default(autoincrement())
  nguoiDungId   BigInt?  @map("nguoi_dung_id")
  hanhDong      String   @map("hanh_dong") @db.VarChar(100)
  loaiDoiTuong  String   @map("loai_doi_tuong") @db.VarChar(100)
  doiTuongId    BigInt?  @map("doi_tuong_id")
  duLieuCu      Json?    @map("du_lieu_cu") @db.JsonB
  duLieuMoi     Json?    @map("du_lieu_moi") @db.JsonB
  diaChiIp      String?  @map("dia_chi_ip") @db.Inet
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  nguoiDung     NguoiDung? @relation(fields: [nguoiDungId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([nguoiDungId], name: "idx_nhat_ky_nguoi_dung")
  @@index([loaiDoiTuong, doiTuongId], name: "idx_nhat_ky_doi_tuong")
  @@index([createdAt], name: "idx_nhat_ky_created_at")
  @@map("nhat_ky_he_thong")
}

// =========================================================
// 18. CAU HINH HE THONG (System Config)
// =========================================================

model CauHinhHeThong {
  id            BigInt   @id @default(autoincrement())
  maCauHinh     String   @unique @map("ma_cau_hinh") @db.VarChar(100)
  giaTri        String?  @map("gia_tri") @db.Text
  moTa          String?  @map("mo_ta") @db.Text
  dangHoatDong  Boolean  @default(true) @map("dang_hoat_dong")
