CREATE INDEX idx_yeu_cau_nguoi_dung
    ON yeu_cau_thay_doi_lich (nguoi_dung_id);

CREATE INDEX idx_yeu_cau_trang_thai
    ON yeu_cau_thay_doi_lich (trang_thai);


