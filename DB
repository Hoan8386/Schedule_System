-- =========================================================
-- DATABASE: QUAN LY DANG KY LICH LAM VIEC
-- PostgreSQL
-- =========================================================

-- =========================================================
-- 1. VAI TRO
-- =========================================================

CREATE TABLE vai_tro (
    id BIGSERIAL PRIMARY KEY,

    ma_vai_tro VARCHAR(50) NOT NULL UNIQUE,

    ten_vai_tro VARCHAR(100) NOT NULL,

    mo_ta TEXT,

    dang_hoat_dong BOOLEAN NOT NULL DEFAULT TRUE,

    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX idx_vai_tro_dang_hoat_dong
    ON vai_tro (dang_hoat_dong);


-- =========================================================
-- 2. QUYEN
-- =========================================================

CREATE TABLE quyen (
    id BIGSERIAL PRIMARY KEY,

    ma_quyen VARCHAR(100) NOT NULL UNIQUE,

    ten_quyen VARCHAR(150) NOT NULL,

    api_path VARCHAR(255) NOT NULL,

    http_method VARCHAR(10) NOT NULL,

    mo_ta TEXT,

    dang_hoat_dong BOOLEAN NOT NULL DEFAULT TRUE,

    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT chk_quyen_http_method
        CHECK (
            http_method IN (
                'GET',
                'POST',
                'PUT',
                'PATCH',
                'DELETE',
                'OPTIONS'
            )
        ),

    CONSTRAINT uk_quyen_api
        UNIQUE (api_path, http_method)
);

CREATE INDEX idx_quyen_api_path
    ON quyen (api_path);

CREATE INDEX idx_quyen_http_method
    ON quyen (http_method);

CREATE INDEX idx_quyen_dang_hoat_dong
    ON quyen (dang_hoat_dong);


-- =========================================================
-- 3. NGUOI DUNG
-- =========================================================

CREATE TABLE nguoi_dung (
    id BIGSERIAL PRIMARY KEY,

    ma_nguoi_dung VARCHAR(50) NOT NULL UNIQUE,

    ho_ten VARCHAR(255) NOT NULL,

    email VARCHAR(255) NOT NULL UNIQUE,

    so_dien_thoai VARCHAR(20) UNIQUE,

    mat_khau VARCHAR(255) NOT NULL,

    anh_dai_dien VARCHAR(500),

    vai_tro_id BIGINT NOT NULL,

    trang_thai VARCHAR(30) NOT NULL DEFAULT 'HOAT_DONG',

    lan_dang_nhap_cuoi TIMESTAMPTZ,

    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_nguoi_dung_vai_tro
        FOREIGN KEY (vai_tro_id)
        REFERENCES vai_tro(id)
        ON DELETE RESTRICT
        ON UPDATE CASCADE,

    CONSTRAINT chk_nguoi_dung_trang_thai
        CHECK (
            trang_thai IN (
                'HOAT_DONG',
                'KHONG_HOAT_DONG',
                'BI_KHOA'
            )
        )
);

CREATE INDEX idx_nguoi_dung_vai_tro
    ON nguoi_dung (vai_tro_id);

CREATE INDEX idx_nguoi_dung_trang_thai
    ON nguoi_dung (trang_thai);


-- =========================================================
-- 4. VAI TRO - QUYEN
-- =========================================================

CREATE TABLE vai_tro_quyen (
    id BIGSERIAL PRIMARY KEY,

    vai_tro_id BIGINT NOT NULL,

    quyen_id BIGINT NOT NULL,

    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_vai_tro_quyen_vai_tro
        FOREIGN KEY (vai_tro_id)
        REFERENCES vai_tro(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE,

    CONSTRAINT fk_vai_tro_quyen_quyen
        FOREIGN KEY (quyen_id)
        REFERENCES quyen(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE,

    CONSTRAINT uk_vai_tro_quyen
        UNIQUE (vai_tro_id, quyen_id)
);

CREATE INDEX idx_vai_tro_quyen_vai_tro
    ON vai_tro_quyen (vai_tro_id);

CREATE INDEX idx_vai_tro_quyen_quyen
    ON vai_tro_quyen (quyen_id);


-- =========================================================
-- 5. CA LAM VIEC
-- =========================================================

CREATE TABLE ca_lam_viec (
    id BIGSERIAL PRIMARY KEY,

    ma_ca VARCHAR(50) NOT NULL UNIQUE,

    ten_ca VARCHAR(100) NOT NULL,

    gio_bat_dau TIME NOT NULL,

    gio_ket_thuc TIME NOT NULL,

    so_nguoi_toi_da INTEGER NOT NULL,

    thu_tu_hien_thi INTEGER NOT NULL DEFAULT 0,

    trang_thai VARCHAR(30) NOT NULL DEFAULT 'HOAT_DONG',

    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT chk_ca_lam_viec_thoi_gian
        CHECK (gio_ket_thuc > gio_bat_dau),

    CONSTRAINT chk_ca_lam_viec_so_nguoi
        CHECK (so_nguoi_toi_da > 0),

    CONSTRAINT chk_ca_lam_viec_trang_thai
        CHECK (
            trang_thai IN (
                'HOAT_DONG',
                'KHONG_HOAT_DONG'
            )
        )
);

CREATE INDEX idx_ca_lam_viec_trang_thai
    ON ca_lam_viec (trang_thai);


-- =========================================================
-- 6. KY DANG KY LICH
-- =========================================================

CREATE TABLE ky_dang_ky_lich (
    id BIGSERIAL PRIMARY KEY,

    ten_ky VARCHAR(100) NOT NULL,

    nam INTEGER NOT NULL,

    thang INTEGER NOT NULL,

    thoi_gian_mo_dang_ky TIMESTAMPTZ,

    thoi_gian_dong_dang_ky TIMESTAMPTZ,

    thoi_gian_chot_lich TIMESTAMPTZ,

    trang_thai VARCHAR(30) NOT NULL DEFAULT 'NHAP',

    nguoi_tao_id BIGINT,

    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_ky_dang_ky_lich_nguoi_tao
        FOREIGN KEY (nguoi_tao_id)
        REFERENCES nguoi_dung(id)
        ON DELETE SET NULL
        ON UPDATE CASCADE,

    CONSTRAINT chk_ky_dang_ky_lich_thang
        CHECK (thang BETWEEN 1 AND 12),

    CONSTRAINT chk_ky_dang_ky_lich_nam
        CHECK (nam >= 2000),

    CONSTRAINT chk_ky_dang_ky_lich_trang_thai
        CHECK (
            trang_thai IN (
                'NHAP',
                'MO',
                'DONG',
                'DA_CHOT'
            )
        ),

    CONSTRAINT uk_ky_dang_ky_lich_nam_thang
        UNIQUE (nam, thang)
);

CREATE INDEX idx_ky_dang_ky_lich_trang_thai
    ON ky_dang_ky_lich (trang_thai);


-- =========================================================
-- 7. CA LAM VIEC THEO NGAY
-- =========================================================

CREATE TABLE ca_lam_viec_theo_ngay (
    id BIGSERIAL PRIMARY KEY,

    ky_dang_ky_lich_id BIGINT NOT NULL,

    ca_lam_viec_id BIGINT NOT NULL,

    ngay_lam_viec DATE NOT NULL,

    gio_bat_dau TIME NOT NULL,

    gio_ket_thuc TIME NOT NULL,

    so_nguoi_toi_da INTEGER NOT NULL,

    trang_thai VARCHAR(30) NOT NULL DEFAULT 'MO',

    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_ca_theo_ngay_ky
        FOREIGN KEY (ky_dang_ky_lich_id)
        REFERENCES ky_dang_ky_lich(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE,

    CONSTRAINT fk_ca_theo_ngay_ca
        FOREIGN KEY (ca_lam_viec_id)
        REFERENCES ca_lam_viec(id)
        ON DELETE RESTRICT
        ON UPDATE CASCADE,

    CONSTRAINT chk_ca_theo_ngay_thoi_gian
        CHECK (gio_ket_thuc > gio_bat_dau),

    CONSTRAINT chk_ca_theo_ngay_so_nguoi
        CHECK (so_nguoi_toi_da > 0),

    CONSTRAINT chk_ca_theo_ngay_trang_thai
        CHECK (
            trang_thai IN (
                'MO',
                'DA_DAY',
                'DONG',
                'HUY'
            )
        ),

    CONSTRAINT uk_ca_theo_ngay
        UNIQUE (ca_lam_viec_id, ngay_lam_viec)
);

CREATE INDEX idx_ca_theo_ngay_ky
    ON ca_lam_viec_theo_ngay (ky_dang_ky_lich_id);

CREATE INDEX idx_ca_theo_ngay_ngay
    ON ca_lam_viec_theo_ngay (ngay_lam_viec);

CREATE INDEX idx_ca_theo_ngay_trang_thai
    ON ca_lam_viec_theo_ngay (trang_thai);


-- =========================================================
-- 8. DANG KY CA
-- =========================================================

CREATE TABLE dang_ky_ca (
    id BIGSERIAL PRIMARY KEY,

    nguoi_dung_id BIGINT NOT NULL,

    ca_lam_viec_theo_ngay_id BIGINT NOT NULL,

    trang_thai VARCHAR(30) NOT NULL DEFAULT 'CHO_DUYET',

    thoi_gian_dang_ky TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    thoi_gian_duyet TIMESTAMPTZ,

    nguoi_duyet_id BIGINT,

    thoi_gian_tu_choi TIMESTAMPTZ,

    nguoi_tu_choi_id BIGINT,

    ly_do_tu_choi TEXT,

    ghi_chu TEXT,

    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_dang_ky_ca_nguoi_dung
        FOREIGN KEY (nguoi_dung_id)
        REFERENCES nguoi_dung(id)
        ON DELETE RESTRICT
        ON UPDATE CASCADE,

    CONSTRAINT fk_dang_ky_ca_ca
        FOREIGN KEY (ca_lam_viec_theo_ngay_id)
        REFERENCES ca_lam_viec_theo_ngay(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE,

    CONSTRAINT fk_dang_ky_ca_nguoi_duyet
        FOREIGN KEY (nguoi_duyet_id)
        REFERENCES nguoi_dung(id)
        ON DELETE SET NULL
        ON UPDATE CASCADE,

    CONSTRAINT fk_dang_ky_ca_nguoi_tu_choi
        FOREIGN KEY (nguoi_tu_choi_id)
        REFERENCES nguoi_dung(id)
        ON DELETE SET NULL
        ON UPDATE CASCADE,

    CONSTRAINT chk_dang_ky_ca_trang_thai
        CHECK (
            trang_thai IN (
                'CHO_DUYET',
                'DA_DUYET',
                'TU_CHOI',
                'DA_HUY'
            )
        ),

    CONSTRAINT uk_dang_ky_ca
        UNIQUE (nguoi_dung_id, ca_lam_viec_theo_ngay_id)
);

CREATE INDEX idx_dang_ky_ca_nguoi_dung
    ON dang_ky_ca (nguoi_dung_id);

CREATE INDEX idx_dang_ky_ca_ca
    ON dang_ky_ca (ca_lam_viec_theo_ngay_id);

CREATE INDEX idx_dang_ky_ca_trang_thai
    ON dang_ky_ca (trang_thai);


-- =========================================================
-- 9. YEU CAU THAY DOI LICH
